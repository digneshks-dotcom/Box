# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Where the SQLite database file is stored
DB_PATH=./data/erp.sqlite

# Used once by `npm run init-admin` to create the first login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Comma-separated list of allowed origins, e.g. https://erp.yourcompany.com
# Use * only for local testing, never in production
CORS_ORIGIN=*

NODE_ENV=production
